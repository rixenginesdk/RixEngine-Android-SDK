<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_action_bar" />


    <TextView
        android:id="@+id/tv_load_show"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/load_and_show_ad"
        style="@style/style_btn"/>


    <com.google.android.gms.ads.admanager.AdManagerAdView
        android:id="@+id/gam_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_gravity="center_horizontal"
        app:adSize="BANNER"
        app:adUnitId="@string/gam_banner_id"/>

    <TextView
        android:id="@+id/tv_clear_log"
        android:layout_width="100dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="10dp"
        android:text="@string/clear_log"
        style="@style/style_btn"
        android:layout_gravity="end"/>

    <TextView
        android:id="@+id/tv_show_log"
        android:layout_width="match_parent"
        android:layout_height="@dimen/log_height"
        style="@style/style_log"/>


</LinearLayout>